# Frontend build configuration. Copy to .env.local for local overrides.
#
# Vite inlines VITE_* variables at BUILD time — they are not read at runtime, so
# changing this needs a rebuild (on Render, a redeploy).

# Origin of the Java API.
#
# Leave EMPTY for local development: `npm run dev` proxies /api to
# localhost:8080, so the browser stays on one origin.
#
# Set it for a deployed build, where the frontend and API are on different
# hosts. No trailing slash needed.
VITE_API_BASE_URL=https://your-api.onrender.com
