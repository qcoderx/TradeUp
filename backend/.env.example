# TradeUp — copy to .env and fill in. The .env file is gitignored.

# --- Database (PostgreSQL) -------------------------------------------------
# From the Neon dashboard, take the connection string and rewrite it for JDBC:
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# becomes
#   jdbc:postgresql://HOST/DB?sslmode=require   (user and password go below)
# Drop channel_binding: it is a libpq option the JDBC driver does not accept.
TRADEUP_DB_URL=jdbc:postgresql://YOUR-HOST.neon.tech/neondb?sslmode=require
TRADEUP_DB_USER=your_db_user
TRADEUP_DB_PASSWORD=your_db_password

# --- Auth ------------------------------------------------------------------
# Signing key for issued JWTs. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
TRADEUP_JWT_SECRET=change-this-to-a-long-random-string-of-at-least-32-chars

# --- Optional --------------------------------------------------------------
# Comma-separated origins allowed to call the API.
# TRADEUP_CORS_ORIGINS=http://localhost:5173
# Set false to stop the sample catalogue being written to an empty database.
# TRADEUP_SEED_ENABLED=true
