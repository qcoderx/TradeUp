# Copy to .env and fill in. Never commit the real file.

# Signing key for the JWTs the API issues. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
TRADEUP_JWT_SECRET=change-this-to-a-long-random-string-of-at-least-32-chars

# Only needed to regenerate the brand and listing imagery with
# tools/generate-assets.mjs. The generated files are committed, so day-to-day
# development does not need this at all.
OPENAI_API_KEY=
